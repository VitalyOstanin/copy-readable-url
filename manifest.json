{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__"
  },
  "permissions": ["activeTab", "contextMenus", "offscreen", "clipboardWrite"],
  "commands": {
    "copy-page-url": {
      "suggested_key": { "default": "Alt+U" },
      "description": "__MSG_copyPageUrl__"
    },
    "copy-page-markdown": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "__MSG_copyPageMarkdown__"
    }
  }
}
